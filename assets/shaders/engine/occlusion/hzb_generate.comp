#version 450 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D u_in_depth;
layout(binding = 1, r32f) uniform writeonly image2D u_out_depth;

uniform ivec2 u_out_resolution;
uniform int u_src_mip_level;

void main() {
    ivec2 out_pos = ivec2(gl_GlobalInvocationID.xy);

    if (out_pos.x >= u_out_resolution.x || out_pos.y >= u_out_resolution.y) {
        return;
    }

    ivec2 in_pos = out_pos * 2;

    float d0 = texelFetch(u_in_depth, in_pos + ivec2(0, 0), u_src_mip_level).r;
    float d1 = texelFetch(u_in_depth, in_pos + ivec2(1, 0), u_src_mip_level).r;
    float d2 = texelFetch(u_in_depth, in_pos + ivec2(0, 1), u_src_mip_level).r;
    float d3 = texelFetch(u_in_depth, in_pos + ivec2(1, 1), u_src_mip_level).r;

    float max_depth = max(max(d0, d1), max(d2, d3));

    imageStore(u_out_depth, out_pos, vec4(max_depth, 0.0, 0.0, 0.0));
}