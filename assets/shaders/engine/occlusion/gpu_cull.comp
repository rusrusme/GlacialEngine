#version 450 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct InstanceAABB {
    vec4 min_pos;
    vec4 max_pos;
};

layout(std430, binding = 0) readonly buffer InstanceAABBBuffer {
    InstanceAABB u_aabbs[];
};

layout(std430, binding = 1) writeonly buffer VisibilityBuffer {
    uint u_visibility[];
};

uniform int u_num_instances;
uniform vec4 u_frustum_planes[6]; // Left, Right, Bottom, Top, Near, Far

bool intersects_frustum(vec3 min_pos, vec3 max_pos) {
    // Sichere AABB-Berechnung (verhindert negative Extents durch Rotationen)
    vec3 real_min = min(min_pos, max_pos);
    vec3 real_max = max(min_pos, max_pos);

    vec3 center = (real_min + real_max) * 0.5;
    vec3 extents = (real_max - real_min) * 0.5;

    for (int i = 0; i < 6; ++i) {
        vec3 plane_normal = u_frustum_planes[i].xyz;
        float plane_dist = u_frustum_planes[i].w;

        float radius = dot(extents, abs(plane_normal));
        float dist = dot(plane_normal, center) + plane_dist;

        if (dist < -radius) {
            return false; // Ausßerhalb dieser Frustum-Ebene
        }
    }
    return true;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= u_num_instances) return;

    vec3 box_min = u_aabbs[idx].min_pos.xyz;
    vec3 box_max = u_aabbs[idx].max_pos.xyz;

    u_visibility[idx] = intersects_frustum(box_min, box_max) ? 1u : 0u;
}