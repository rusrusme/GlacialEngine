#version 450 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct InstanceData {
    mat4 transform;
    vec4 color;
    vec2 pbr;
    vec2 padding;
};

layout(std430, binding = 0) readonly buffer InputInstances {
    InstanceData u_instances[];
};

layout(std430, binding = 1) writeonly buffer VisibilityBuffer {
    uint u_visibility[];
};

uniform int u_num_instances;
uniform vec3 u_mesh_aabb_min;
uniform vec3 u_mesh_aabb_max;
uniform vec4 u_frustum_planes[6];

bool intersects_frustum(vec3 min_pos, vec3 max_pos) {
    vec3 center = (min_pos + max_pos) * 0.5;
    vec3 extents = (max_pos - min_pos) * 0.5;

    for (int i = 0; i < 6; ++i) {
        vec3 plane_normal = u_frustum_planes[i].xyz;
        float plane_dist = u_frustum_planes[i].w;

        float radius = dot(extents, abs(plane_normal));
        float dist = dot(plane_normal, center) + plane_dist;

        if (dist < -radius) return false;
    }
    return true;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uint(u_num_instances)) return;

    mat4 transform = u_instances[idx].transform;

    // Welt-AABB direkt auf der GPU berechnen (O(1) in Parallel-Threads)
    vec3 local_center = (u_mesh_aabb_min + u_mesh_aabb_max) * 0.5;
    vec3 local_extents = (u_mesh_aabb_max - u_mesh_aabb_min) * 0.5;

    vec3 world_center = vec3(transform * vec4(local_center, 1.0));
    mat3 abs_matrix = mat3(
            abs(vec3(transform[0])),
            abs(vec3(transform[1])),
            abs(vec3(transform[2]))
    );
    vec3 world_extents = abs_matrix * local_extents;

    vec3 world_min = world_center - world_extents;
    vec3 world_max = world_center + world_extents;

    u_visibility[idx] = intersects_frustum(world_min, world_max) ? 1u : 0u;
}