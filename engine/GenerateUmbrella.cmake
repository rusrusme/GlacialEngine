file(GLOB_RECURSE ENGINE_PUBLIC_HEADERS
     RELATIVE "${CMAKE_CURRENT_SOURCE_DIR}/include"
     CONFIGURE_DEPENDS
     "${CMAKE_CURRENT_SOURCE_DIR}/include/*.hpp"
     "${CMAKE_CURRENT_SOURCE_DIR}/include/*.h"
)

list(FILTER ENGINE_PUBLIC_HEADERS EXCLUDE REGEX "(^|/)Engine\\.hpp$")
list(FILTER ENGINE_PUBLIC_HEADERS EXCLUDE REGEX "(^|/)platform/")
list(SORT ENGINE_PUBLIC_HEADERS)

string(CONCAT ENGINE_UMBRELLA_CONTENT
       "// Auto-generated by CMake\n"
       "// Copyright (c) 2026 rusrusme\n"
       "// All rights reserved.\n\n"
       "#pragma once\n\n"
)

foreach (HEADER IN LISTS ENGINE_PUBLIC_HEADERS)
    string(APPEND ENGINE_UMBRELLA_CONTENT "#include \"${HEADER}\"\n")
endforeach ()

set(GENERATED_INCLUDE_DIR "${CMAKE_CURRENT_BINARY_DIR}/generated")
file(GENERATE OUTPUT "${GENERATED_INCLUDE_DIR}/GlacialEngine.hpp" CONTENT "${ENGINE_UMBRELLA_CONTENT}")

target_include_directories(Engine PUBLIC "${GENERATED_INCLUDE_DIR}")